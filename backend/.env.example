# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=potholesafe
DB_USER=root
DB_PASSWORD=your_password_here
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_RETRY_MAX=3

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
REQUEST_BODY_LIMIT=1mb

# Image Verification
VERIFICATION_MODE=mock
GOOGLE_CLOUD_API_KEY=your_api_key_here
CONFIDENCE_THRESHOLD=0.6

# Session (must be at least 32 characters in production)
SESSION_SECRET=change-this-to-a-random-64-char-string

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
# Optional wildcard patterns (for example: https://*.vercel.app)
ALLOWED_ORIGIN_PATTERNS=

# Reverse proxy (set to true or 1 on Railway)
TRUST_PROXY=false

# Metrics endpoint (/api/metrics)
ENABLE_METRICS=false
METRICS_TOKEN=
ENABLE_FRONTEND_TELEMETRY=true

# Migration safeguards
ALLOW_DESTRUCTIVE_MIGRATION_ROLLBACK=false

# One-time admin bootstrap for `npm run db:init`
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

# Backup/restore safeguards
ALLOW_DB_RESTORE=false
BACKUP_DIR=../database/backups
MYSQL_BIN=mysql
MYSQLDUMP_BIN=mysqldump
REPORT_RETENTION_DAYS=90
